[node name="Label" type="Label" parent="help/CenterContainer/VBoxContainer/HBoxContainer/VBoxContainer ENG"]
layout_mode = 2
text = "
WASD - movement
E - inventory
esc - close menu
space - jump
B - toggle build mode
Left mouse - build
Right mouse - remove building
R - rotate clockwise
shift + R - rotate counter clockwise
1-4 - select building (3 doesnt work, can also select from inventory)
backspace - unselect building
f4 - close game

clicking on a recipe inside your own inventory crafts the item from your inventory
clicking on a recipe inside a building sets the buildings recipe
hovering over recipes shows their ingridients and products

debug:
pgup - populate containers
pgdn - infinite building materials"

[node name="Container" type="Container" parent="help/CenterContainer/VBoxContainer/HBoxContainer"]
